{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytube-extractor",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 5000 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "vars": { "RATE_LIMIT_DAILY_REQUESTS": "200", "RATE_LIMIT_WEEKLY_REQUESTS": "1000" },
  "secrets": { "required": ["ACCESS_TOKEN", "MEDIA_SIGNING_KEY"] },
  "durable_objects": { "bindings": [{ "name": "APP_RATE_LIMITER", "class_name": "AppRateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppRateLimiter"] }]
}
